# PostgreSQL Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=incident_investigator
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/incident_investigator

# Backend API Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:3000"]

# Ollama LLM Configuration
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=qwen3:4b
OLLAMA_TIMEOUT_SECONDS=120.0
EMBEDDING_MODEL=all-minilm

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_USE_MOCK=false
NEXT_PUBLIC_API_KEY=dev-admin-key

# Security & Reliability Configuration
AUTH_ENABLED=true
MAX_REQUEST_BODY_BYTES=10000000
MAX_TELEMETRY_BATCH_SIZE=1000
MAX_CONCURRENT_INVESTIGATIONS=2
RETENTION_TELEMETRY_HOURS=168

